XMPP_SERVER=192.168.0.000
XMPP_PORT=5222
XMPP_USERNAME=user@domain
XMPP_PASSWORD=password
REST_HOST=127.0.0.1
REST_PORT=8080
REST_API_KEY=your-secret-api-key
# Контракт v1.0 (необязательно)
REST_ALLOW_API_KEY_QUERY=false
REST_LEGACY_PAYLOAD_AS_MESSAGE=false
REST_BROADCAST_MAX_RECIPIENTS=200
REST_TRUSTED_SENDERS=server@domain
REST_PUBLIC_HOST=
REST_PUBLIC_PORT=
# Ключ шифрования паролей реестра терминалов (Fernet). Если не задан — создаётся файл
# device_registry.key рядом с БД. Сгенерировать:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DEVICE_REGISTRY_KEY=

# Kafka (необязательно; используется только если kafka.enabled=true)
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=xmpp-client
KAFKA_USE_FOR_API_QUEUE=false
KAFKA_PUBLISH_ALL_MESSAGES=true
KAFKA_PUBLISH_API_REQUESTS=true
KAFKA_CONSUME_API_REQUESTS=true
